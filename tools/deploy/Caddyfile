# Replace game.example.com with your own hostname before installing.
game.example.com {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
    }
    @private path /api/local-control /api/local-control/*
    handle @private {
        respond 404
    }
    @backend path /api/* /socket.io/*
    handle @backend {
        reverse_proxy 127.0.0.1:3001 {
            # Replace client-supplied forwarding headers at the public edge.
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up -X-Local-Control
        }
    }
    handle {
        root * /opt/gachatriad/current/apps/web/out
        @immutable path /_next/static/*
        header @immutable Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
}
