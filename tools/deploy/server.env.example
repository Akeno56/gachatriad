# Install as /etc/gachatriad/server.env, readable only by root (chmod 600).
# Replace the hostname and secret. This file is never copied into the web root.
NODE_ENV=production
DATA_DIR=/var/lib/gachatriad
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
CONTROL_PORT=3030
CLIENT_ORIGIN=https://game.example.com
FRONTEND_URL=https://game.example.com/
BETTER_AUTH_URL=https://game.example.com
LOCAL_BOTS=true
# No POPULATE_BOTS/BOT_DIFFICULTY override: retain saved admin choices.
EXTERNAL_GAME_SERVER=true
LOCAL_CONTROL_SECRET=REPLACE_WITH_64_RANDOM_HEXADECIMAL_CHARACTERS
# BETTER_AUTH_SECRET is intentionally omitted: the persistent auth-secret file
# is generated automatically for the clean server. Do not copy the old PC save.
