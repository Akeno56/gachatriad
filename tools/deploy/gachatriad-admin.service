[Unit]
Description=Gacha Triad private administration console
Wants=gachatriad.service
After=gachatriad.service

[Service]
Type=simple
User=gachatriad
Group=gachatriad
WorkingDirectory=/opt/gachatriad/current
EnvironmentFile=/etc/gachatriad/server.env
Environment=PATH=/opt/node24/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/node24/bin/node tools/server-control/index.mjs
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
StateDirectory=gachatriad
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gachatriad

[Install]
WantedBy=multi-user.target
